{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DefectDetection",
  "version": "0.1.0",
  "identifier": "com.bkvision.defect",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "npm --prefix ../../../Figmaaidefectdetectionsystem run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../Figmaaidefectdetectionsystem/build"
  },
  "app": {
    "windows": [
      {
        "title": "DefectDetection",
        "width": 1120,
        "height": 720,
        "decorations": false,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 0,
        "minHeight": 0,
        "maximized": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "../../../resource/icon/icon.ico",
      "../../../resource/icon/icon.png",
      "../../../resource/icon/icon.icns"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
